     A* CUSTSELD: pick a customer (window)
     A*
     A                                      DSPSIZ(24 80 *DS3)
     A                                      INDARA
     A                                      CA12(12 'Cancel')
     A          R SELSFL                    SFL
     A            SOPT           1A  B  5  3
     A            SCUST          6S 0O  5  7
     A            SNAME         30A  O  5 15
     A          R SELCTL                    SFLCTL(SELSFL)
     A                                      SFLSIZ(0050)
     A                                      SFLPAG(0008)
     A                                      WINDOW(3 18 15 46)
     A                                      WDWTITLE((*TEXT 'Select Customer'))
     A  31                                  SFLDSP
     A  32                                  SFLDSPCTL
     A  33                                  SFLCLR
     A  34                                  SFLEND(*MORE)
     A                                  1  2'Position to . .'
     A            SPOS          20A  B  1 18
     A                                      CHECK(LC)
     A                                  2  2'Type 1 to select, press Enter.'
     A                                      COLOR(BLU)
     A                                  4  2'Opt'
     A                                      COLOR(WHT)
     A                                  4  7'Number'
     A                                      COLOR(WHT)
     A                                  4 15'Name'
     A                                      COLOR(WHT)
     A                                 15  2'F12=Cancel'
     A                                      COLOR(BLU)
